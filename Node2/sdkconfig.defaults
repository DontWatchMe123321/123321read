CONFIG_IDF_TARGET="esp32"
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PROVISIONER=n
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_PB_GATT=n
CONFIG_BLE_MESH_SETTINGS=y
CONFIG_BLE_MESH_RELAY=n
CONFIG_BLE_MESH_FRIEND=n
CONFIG_BLE_MESH_LOW_POWER=y
CONFIG_BLE_MESH_GENERIC_SERVER=n
CONFIG_NODE2_SOIL_ADC_ENABLE=y
CONFIG_NODE2_SOIL_ADC_DRY_RAW=3000
CONFIG_NODE2_SOIL_ADC_WET_RAW=1500
CONFIG_NODE2_SLEEP_INTERVAL_SEC=300
