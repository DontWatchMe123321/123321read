CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PB_ADV=y
# PB-GATT selects BLE_MESH_PROXY in ESP-IDF 6.1.1, so use PB-ADV only here.
CONFIG_BLE_MESH_PB_GATT=n
CONFIG_BLE_MESH_PROXY=n
CONFIG_BLE_MESH_GATT_PROXY_SERVER=n
CONFIG_BLE_MESH_SETTINGS=y
CONFIG_BLE_MESH_RELAY=y
CONFIG_BLE_MESH_FRIEND=y
# CFG_SRV and Generic OnOff Server are model instances declared in main.c.
CONFIG_BLE_MESH_GENERIC_SERVER=y
